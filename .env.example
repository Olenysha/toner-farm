# Скопируйте в .env и поправьте под свою площадку.
# Все значения необязательны — в docker-compose.yml есть разумные значения по умолчанию.

# --- Active Directory / LDAP ---
TF_DOMAIN=farm.local
TF_LDAP_PORT=389
TF_VIEW_GROUP=TonerFarm-View
TF_EDIT_GROUP=IT_support

# Локальный запасной вход, если AD недоступен (например, дома или в Docker без LDAP)
TF_LOCAL_ADMIN=admin
TF_LOCAL_ADMIN_PASSWORD=changeme

# --- SNMP ---
SNMP_COMMUNITY=public
SNMP_INTERVAL=600

# --- HTTPS внутри контейнера (опционально) ---
# Для камеры телефона нужен HTTPS. Варианты:
# 1) reverse proxy с TLS (рекомендуется для продакшена)
# 2) положить self-signed пару в ./certs/cert.pem и ./certs/key.pem,
#    раскомментировать строки ниже и в docker-compose.yml
# CERT_FILE=/app/certs/cert.pem
# KEY_FILE=/app/certs/key.pem
